<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_JLRT" targetNamespace="https://github.com/JLRT" exporter="JLRT docs" exporterVersion="1.0">
  <bpmn:message id="Msg_Consulta" name="Consulta" />
  <bpmn:message id="Msg_Charla" name="Consulta en persona" />
  <bpmn:message id="Msg_Aceptacion" name="Aceptación escrita" />
  <bpmn:message id="Msg_Respuesta" name="Respuesta a la propuesta" />
  <bpmn:collaboration id="Collaboration_Captacion">
    <bpmn:participant id="Participant_Cliente" name="Cliente potencial (PyME)" />
    <bpmn:participant id="Participant_JLRT" name="JLRT Software — Captación y gestión comercial de consultas" processRef="Process_Captacion" />
    <bpmn:messageFlow id="M01" name="Consulta" sourceRef="Participant_Cliente" targetRef="Start_Formulario" />
    <bpmn:messageFlow id="M02" name="Datos faltantes" sourceRef="Task_Faltantes" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="M03" name="Consulta en persona" sourceRef="Participant_Cliente" targetRef="Start_Charla" />
    <bpmn:messageFlow id="M04" name="Pedido de consentimiento" sourceRef="Task_PedirCons" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="M05" name="Aceptación escrita" sourceRef="Participant_Cliente" targetRef="Catch_Aceptacion" />
    <bpmn:messageFlow id="M06" name="Primer contacto" sourceRef="Task_Contactar" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="M07" name="Demo" sourceRef="Task_Demo" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="M08" name="Propuesta" sourceRef="Task_Propuesta" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="M09" name="Respuesta" sourceRef="Participant_Cliente" targetRef="Catch_Respuesta" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Captacion" name="Captación y gestión comercial de consultas" isExecutable="false">
    <bpmn:laneSet id="LaneSet_JLRT">
      <bpmn:lane id="Lane_Socio" name="Socio responsable (Líder Técnico o Desarrollador Full Stack)">
        <bpmn:flowNodeRef>Task_Contactar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_3h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Charla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cargar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PedirCons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Espera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Aceptacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Plazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Suprimir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Descartada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Union</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Demo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Demo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Propuesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_EsperaResp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Respuesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Acepta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ganada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Ganada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Perdida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Perdida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Perdida</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Módulo de captación (sistema)">
        <bpmn:flowNodeRef>Start_Formulario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Faltantes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoRegistrada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Duplicado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Unificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Unificada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Avisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarcarM3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Demora</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Venc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SinResp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SinResp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Formulario" name="Consulta enviada por el formulario">
      <bpmn:outgoing>F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Start_Formulario" messageRef="Msg_Consulta" />
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_Validar" name="Validar los datos y el consentimiento">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gw_Datos" name="¿Datos completos y consentimiento aceptado?" gatewayDirection="Diverging">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Faltantes" name="Indicar en el formulario qué falta">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_NoRegistrada" name="Consulta no registrada">
      <bpmn:incoming>F04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Duplicado" name="¿Ya hay una consulta abierta del mismo contacto y producto?" gatewayDirection="Diverging">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_Unificar" name="Agregar el mensaje a la consulta existente">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Unificada" name="Consulta unificada">
      <bpmn:incoming>F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Task_Registrar" name="Registrar la consulta como nueva">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Avisar" name="Avisar a los socios por correo">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Task_Contactar" name="Tomar la consulta y contactar al cliente">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Timer_3h" name="3 horas sin contacto" cancelActivity="false" attachedToRef="Task_Contactar">
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_Timer_3h"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT3H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:scriptTask id="Task_MarcarM3" name="Marcar la consulta fuera de la meta M3">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_Demora" name="Demora registrada">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Charla" name="Consulta surgida en una charla">
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Start_Charla" messageRef="Msg_Charla" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Cargar" name="Cargar la consulta en el panel">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_PedirCons" name="Pedir el consentimiento por mensaje">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gw_Espera">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_Aceptacion" name="Consentimiento aceptado">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Catch_Aceptacion" messageRef="Msg_Aceptacion" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_Plazo" name="48 horas sin respuesta">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_Catch_Plazo"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Suprimir" name="Suprimir los datos personales">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Descartada" name="Consulta descartada">
      <bpmn:incoming>F26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Union" gatewayDirection="Converging">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Demo" name="¿Quiere una demo?" gatewayDirection="Diverging">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_Demo" name="Hacer la demo con un sistema en uso">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="Task_Propuesta" name="Enviar la propuesta">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gw_EsperaResp">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F41</bpmn:outgoing>
      <bpmn:outgoing>F42</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_Respuesta" name="Respuesta a la propuesta">
      <bpmn:incoming>F41</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Catch_Respuesta" messageRef="Msg_Respuesta" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_Venc" name="30 días sin actividad">
      <bpmn:incoming>F42</bpmn:incoming>
      <bpmn:outgoing>F43</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_Catch_Venc"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="Task_SinResp" name="Cerrar la consulta como sin respuesta">
      <bpmn:incoming>F43</bpmn:incoming>
      <bpmn:outgoing>F44</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End_SinResp" name="Consulta sin respuesta">
      <bpmn:incoming>F44</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Acepta" name="¿Acepta la propuesta?" gatewayDirection="Diverging">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
      <bpmn:outgoing>F37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Ganada" name="Cerrar la consulta como ganada">
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Ganada" name="Consulta ganada">
      <bpmn:incoming>F38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Perdida" gatewayDirection="Converging">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Perdida" name="Cerrar la consulta como perdida">
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Perdida" name="Consulta perdida">
      <bpmn:incoming>F40</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Formulario" targetRef="Task_Validar" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Validar" targetRef="Gw_Datos" />
    <bpmn:sequenceFlow id="F03" name="No" sourceRef="Gw_Datos" targetRef="Task_Faltantes" />
    <bpmn:sequenceFlow id="F04" sourceRef="Task_Faltantes" targetRef="End_NoRegistrada" />
    <bpmn:sequenceFlow id="F05" name="Sí" sourceRef="Gw_Datos" targetRef="Gw_Duplicado" />
    <bpmn:sequenceFlow id="F06" name="Sí" sourceRef="Gw_Duplicado" targetRef="Task_Unificar" />
    <bpmn:sequenceFlow id="F07" sourceRef="Task_Unificar" targetRef="End_Unificada" />
    <bpmn:sequenceFlow id="F08" name="No" sourceRef="Gw_Duplicado" targetRef="Task_Registrar" />
    <bpmn:sequenceFlow id="F09" sourceRef="Task_Registrar" targetRef="Task_Avisar" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Avisar" targetRef="Task_Contactar" />
    <bpmn:sequenceFlow id="F11" sourceRef="Timer_3h" targetRef="Task_MarcarM3" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_MarcarM3" targetRef="End_Demora" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Contactar" targetRef="Gw_Union" />
    <bpmn:sequenceFlow id="F20" sourceRef="Start_Charla" targetRef="Task_Cargar" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_Cargar" targetRef="Task_PedirCons" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_PedirCons" targetRef="Gw_Espera" />
    <bpmn:sequenceFlow id="F23" sourceRef="Gw_Espera" targetRef="Catch_Aceptacion" />
    <bpmn:sequenceFlow id="F24" sourceRef="Gw_Espera" targetRef="Catch_Plazo" />
    <bpmn:sequenceFlow id="F25" sourceRef="Catch_Plazo" targetRef="Task_Suprimir" />
    <bpmn:sequenceFlow id="F26" sourceRef="Task_Suprimir" targetRef="End_Descartada" />
    <bpmn:sequenceFlow id="F27" sourceRef="Catch_Aceptacion" targetRef="Gw_Union" />
    <bpmn:sequenceFlow id="F30" sourceRef="Gw_Union" targetRef="Gw_Demo" />
    <bpmn:sequenceFlow id="F31" name="Sí" sourceRef="Gw_Demo" targetRef="Task_Demo" />
    <bpmn:sequenceFlow id="F32" name="No" sourceRef="Gw_Demo" targetRef="Gw_Perdida" />
    <bpmn:sequenceFlow id="F33" sourceRef="Task_Demo" targetRef="Task_Propuesta" />
    <bpmn:sequenceFlow id="F34" sourceRef="Task_Propuesta" targetRef="Gw_EsperaResp" />
    <bpmn:sequenceFlow id="F41" sourceRef="Gw_EsperaResp" targetRef="Catch_Respuesta" />
    <bpmn:sequenceFlow id="F42" sourceRef="Gw_EsperaResp" targetRef="Catch_Venc" />
    <bpmn:sequenceFlow id="F43" sourceRef="Catch_Venc" targetRef="Task_SinResp" />
    <bpmn:sequenceFlow id="F44" sourceRef="Task_SinResp" targetRef="End_SinResp" />
    <bpmn:sequenceFlow id="F35" sourceRef="Catch_Respuesta" targetRef="Gw_Acepta" />
    <bpmn:sequenceFlow id="F36" name="Sí" sourceRef="Gw_Acepta" targetRef="Task_Ganada" />
    <bpmn:sequenceFlow id="F37" name="No" sourceRef="Gw_Acepta" targetRef="Gw_Perdida" />
    <bpmn:sequenceFlow id="F38" sourceRef="Task_Ganada" targetRef="End_Ganada" />
    <bpmn:sequenceFlow id="F39" sourceRef="Gw_Perdida" targetRef="Task_Perdida" />
    <bpmn:sequenceFlow id="F40" sourceRef="Task_Perdida" targetRef="End_Perdida" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Captacion">
    <bpmndi:BPMNPlane id="Plane_Captacion" bpmnElement="Collaboration_Captacion">
      <bpmndi:BPMNShape id="Participant_Cliente_di" bpmnElement="Participant_Cliente" isHorizontal="true"><dc:Bounds x="60" y="20" width="2050" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_JLRT_di" bpmnElement="Participant_JLRT" isHorizontal="true"><dc:Bounds x="60" y="120" width="2050" height="580" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Socio_di" bpmnElement="Lane_Socio" isHorizontal="true"><dc:Bounds x="90" y="120" width="2020" height="330" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Sistema_di" bpmnElement="Lane_Sistema" isHorizontal="true"><dc:Bounds x="90" y="450" width="2020" height="250" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Formulario_di" bpmnElement="Start_Formulario"><dc:Bounds x="132" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="105" y="552" width="90" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validar_di" bpmnElement="Task_Validar"><dc:Bounds x="215" y="492" width="110" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Datos_di" bpmnElement="Gw_Datos" isMarkerVisible="true"><dc:Bounds x="365" y="505" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="330" y="455" width="120" height="52" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Faltantes_di" bpmnElement="Task_Faltantes"><dc:Bounds x="335" y="602" width="110" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NoRegistrada_di" bpmnElement="End_NoRegistrada"><dc:Bounds x="462" y="622" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="436" y="662" width="88" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Duplicado_di" bpmnElement="Gw_Duplicado" isMarkerVisible="true"><dc:Bounds x="495" y="505" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="453" y="455" width="135" height="52" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Unificar_di" bpmnElement="Task_Unificar"><dc:Bounds x="565" y="602" width="110" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Unificada_di" bpmnElement="End_Unificada"><dc:Bounds x="712" y="622" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="686" y="662" width="88" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Registrar_di" bpmnElement="Task_Registrar"><dc:Bounds x="610" y="492" width="110" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Avisar_di" bpmnElement="Task_Avisar"><dc:Bounds x="755" y="492" width="110" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Contactar_di" bpmnElement="Task_Contactar"><dc:Bounds x="925" y="357" width="110" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_3h_di" bpmnElement="Timer_3h"><dc:Bounds x="997" y="415" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1036" y="435" width="125" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MarcarM3_di" bpmnElement="Task_MarcarM3"><dc:Bounds x="960" y="492" width="110" height="76" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Demora_di" bpmnElement="End_Demora"><dc:Bounds x="1112" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1090" y="552" width="80" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
